{
  "name": "kinetica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "tsx --env-file=.env.local server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx --env-file=.env.local server.ts",
    "serve": "next build && NODE_ENV=production tsx --env-file=.env.local server.ts",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
